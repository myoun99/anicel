#!/usr/bin/env bash
# 🚨★★★THE GATE FOR A PUSH STRAIGHT TO master.
#
# 유저 2026-08-31: 「pr없이 가도 되는거아닌가?」 — for a board-only change,
# yes: CI runs on a master push exactly as it runs on a PR, so the only thing
# a PR was buying was the WAIT. What it also bought was 「master never goes
# red」, and the answer to 「위험 하나도 해결하는 방식으로 가자」 is not me
# remembering to run the gate first. It is this file refusing the push.
#
# ⛔A rule I have to remember is the failure mode this project keeps hitting.
# The machine says no, or it is not solved.
#
# WHAT IT DOES, only for a push whose remote ref is master:
#   · a push that would REWIND master        → REFUSED; origin came back on
#     2026-09-22 and now holds what everyone else follows;
#   · anything outside the board's own files  → REFUSED, use a PR;
#   · board-only                              → `flutter analyze` (no
#     arguments, the real gate) and the board tests must pass first.
# Every other ref — a work/ branch, a tag — walks straight through.
#
# ⚠️`--no-verify` skips this, and CLAUDE.md already says not to use it unless
# 유저 asks. That is the escape hatch git already has; inventing a second one
# would just be a way to not think.
set -u

# ⚠️ONLY THE TRUNK IS GATED — and everything is the trunk until it is named
# here. The gate exists because CI runs on a master push and master must not
# go red; a MIRROR runs no CI, so refusing a push to one buys nothing and
# costs the backup itself. 2026-09-10: 969 commits sat on a single disk with
# no copy anywhere because this hook could not tell a mirror from the trunk.
#
# ⛔Default-deny on purpose: an unnamed remote is still gated. The failure
# that matters is master going red, so a new mirror has to say so here rather
# than an unknown remote sailing through.
case "${1:-}" in
  backup) exit 0 ;;
esac

ZERO='0000000000000000000000000000000000000000'
# Board files, and nothing else. ⚠️Kept in step with ci.yml's `scope` job —
# they answer the same question and a difference between them would mean a
# push the CI filter thinks is an app change, or the other way round.
BOARD='^(tool/board_[a-z_]+\.dart|test/tool/)'

fail() {
  printf '\n\033[31m✖ pre-push: %s\033[0m\n' "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  printf '\n'
  exit 1
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = 'refs/heads/master' ] || continue
  # Deleting master is not something this hook has an opinion about.
  [ "$local_sha" = "$ZERO" ] && continue

  # 🚨A REWIND IS THE ONE THING CI CANNOT CATCH. Until 2026-09-22 origin was
  # frozen and the trunk was the LOCAL master, so a force push cost nothing
  # that was not already on this disk. Now origin/master carries the month
  # the account was suspended and every checkout follows it: a push that is
  # not a fast-forward drops commits from under whoever already pulled them,
  # and a green CI run afterwards would not say a word about it.
  if [ "$remote_sha" != "$ZERO" ] &&
    ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    fail "master 를 되감는 푸시입니다 — origin 의 커밋이 사라집니다." \
      "origin 이 가진 것: $remote_sha" \
      "보내려는 것  : $local_sha" \
      "먼저 당겨서 얹으세요. 정말 되감아야 한다면 --no-verify 입니다."
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    files=$(git diff --name-only "$(git hash-object -t tree /dev/null)" "$local_sha")
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  # ⛔FAIL-SAFE: an empty read means we could not tell what changed, and the
  # answer to 「I do not know」 is the careful branch, not the cheap one.
  if [ -z "$files" ]; then
    fail "무엇이 바뀌었는지 못 읽었습니다 — master 직접 푸시는 막습니다." \
      "PR 로 보내거나, 정말 확실하면 --no-verify 를 씁니다."
  fi

  outside=$(printf '%s\n' "$files" | grep -vE "$BOARD" || true)
  if [ -n "$outside" ]; then
    fail "보드 밖 파일이 있어 master 직접 푸시를 막습니다 — PR 로 보내세요." \
      "$(printf '%s\n' "$outside" | head -5)"
  fi

  printf '\033[36m▶ pre-push: 보드 전용 푸시 — 게이트를 돌립니다\033[0m\n'

  printf '  flutter analyze …\n'
  if ! analyze=$(flutter analyze 2>&1); then
    fail "flutter analyze 가 빨갛습니다." "$(printf '%s' "$analyze" | tail -5)"
  fi
  # 🚨analyze EXITS 0 ON INFOS. 「No issues found!」 is the only line that
  # means clean, and this gate exists precisely so a board push cannot leave
  # master with a warning the other session then has to look at.
  if ! printf '%s' "$analyze" | grep -q 'No issues found!'; then
    fail "flutter analyze 가 할 말이 남았습니다." "$(printf '%s' "$analyze" | tail -5)"
  fi

  printf '  flutter test test/tool …\n'
  if ! tests=$(flutter test test/tool 2>&1); then
    fail "보드 테스트가 빨갛습니다." "$(printf '%s' "$tests" | tail -5)"
  fi

  printf '\033[32m✔ pre-push: 초록 — 보냅니다\033[0m\n'
done

exit 0
