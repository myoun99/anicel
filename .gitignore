# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# NDK build cache — the native engine's Android build writes ~21 MB of
# ninja/CMake state here, per ABI, on the first `flutter run -d <android>`.
# Anywhere, not just packages/qa_native/android: the NDK puts one beside
# every module it builds.
**/.cxx/

# Signing material — never commit. CI reads these from repository secrets.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
AuthKey_*.p8

# Each machine's own, made there by the repository's tools: the settings a
# machine's sessions run by (tool/session_hooks/install.dart writes them)
# and the lanes' worktrees (tool/lane.sh). ⚠️The first machine hid both with
# files only it has — its global ignore and its clone's info/exclude — so a
# second clone showed them as work to commit (2026-10-07, the Surface), and
# a commit on a machine that borrows the trunk is refused by its next
# `lane.sh sync`.
.claude/settings.local.json
.claude/worktrees/
