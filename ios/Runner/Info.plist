				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.myoun.anicel.shortcut</string>
			<key>UTTypeDescription</key>
			<string>Anicel Shortcut Preset</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>anishortcut</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.myoun.anicel.settings</string>
			<key>UTTypeDescription</key>
			<string>Anicel Settings</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>anisettings</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.myoun.anicel.project</string>
			<key>UTTypeDescription</key>
			<string>Anicel Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>anicel</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anicel Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.myoun.anicel.project</string>
			</array>
		</dict>
	</array>
	<!-- PICK-1: media formats Apple does NOT ship a type for. The document
	     picker filters by UTI, and an extension with no declared type is not
	     merely unfiltered - it is UNSELECTABLE, greyed out in Files with no
	     explanation. Importing each one under the identifier its own project
	     uses, and conforming it to public.audio / public.movie, is what makes
	     the broad filters the pickers actually pass (public.audio, etc.) match
	     these files at all. Keep in step with FileTypeGroups on the Dart side. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.adobe.photoshop-large-image</string>
			<key>UTTypeDescription</key>
			<string>Photoshop Large Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>psb</string>
				</array>
			</dict>
		</dict>
		<dict>
