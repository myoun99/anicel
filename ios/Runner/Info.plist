		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- SAVE-1d: the app's Documents folder shows in the Files app
	     ("On My iPad") and its documents open in place - the 앱 문서
	     폴더 contract on iPadOS. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- PICK-1: the .anicel type, declared to the system. Without this the
	     OS has no idea the extension exists, and three things stay broken:
	     the document picker cannot build a filter (file_selector_ios wants
	     UTIs, never extensions), Files shows no "Open in Anicel", and the
	     project file gets a blank generic icon. public.data is the required
	     conformance for a flat document type - NOT com.apple.package, which
	     is the directory-shaped alternative this project deliberately
	     rejected (see the package-format round). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.myoun.anicel.brush</string>
			<key>UTTypeDescription</key>
			<string>Anicel Brush</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>anibrush</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.myoun.anicel.palette</string>
			<key>UTTypeDescription</key>
