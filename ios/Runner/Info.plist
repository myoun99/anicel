<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>FLTEnableFlutterGPU</key>
	<true/>
	<!-- F-509-Q7 (user, 2026-10-30: "넓은 색 영역은 끄자"): wide gamut OFF.
	     Left on (the engine's default when the key is absent), every
	     picture.toImage comes out in the screen's extended-range format
	     (BGRA10_XR), which flutter_gpu names `unknown` - zero bytes a texel -
	     so no write into a frame picture can be sized and every frame is
	     drawn as it stands (FlutterGpuFramePictures.sizes). Off, pictures
	     are BGRA8: written into where they stand, at half the memory. What
	     it costs: P3 photos and video show clamped to sRGB; the canvas
	     itself is 8-bit sRGB and loses nothing. Engine 3.47.4 (9584c67):
	     ios FlutterDartProject.mm reads this key, defaulting to YES. The
	     macOS embedder reads no such key - it turns wide gamut on wherever
	     Impeller runs on an Apple3+ GPU with a P3 screen - so the macOS
	     plist carries none. -->
	<key>FLTEnableWideGamut</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Anicel</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Anicel</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Records guide voice takes onto the timeline.</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
