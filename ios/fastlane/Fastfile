# TestFlight delivery for a team that owns no Mac.
#
# Every signing asset is created ON THE RUNNER from an App Store Connect
# API key, so there is no certificate to export from a Keychain and no
# second repository to hold one. The runner is thrown away afterwards.

default_platform(:ios)

platform :ios do
  desc "Build a signed .ipa and ship it to TestFlight"
  lane :beta do
    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false,
    )

    # CI keychains start empty, so the signing identity has to live
    # somewhere for xcodebuild to find it.
    setup_ci

    # Ask Apple for a distribution certificate and a matching profile,
    # creating them the first time. `force` keeps the profile in step
    # with the app's capabilities instead of reusing a stale one.
    cert(api_key: key)
    sigh(api_key: key, force: true)

    # No increment_build_number here on purpose: CFBundleVersion resolves
    # to $(FLUTTER_BUILD_NUMBER), which Flutter writes into
    # Generated.xcconfig. agvtool would edit a field nothing reads. The
    # workflow passes --build-number to `flutter build` instead.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Anicel.ipa",
    )

    # Processing takes Apple several minutes; waiting for it would just
    # burn runner time. The build shows up in TestFlight on its own.
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
    )
  end
end
