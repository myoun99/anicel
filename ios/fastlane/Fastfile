# Delivery for a team that owns no Mac: TestFlight for the iPad, and a
# signed, notarized Mac app handed over as a file.
#
# The signing identity lives in a private repository, encrypted, because a
# CI runner is thrown away after every run. An earlier version asked Apple
# for a fresh certificate each time (fastlane's `cert`), which fails twice
# over: the private key never survives to the next run, and Apple only
# allows a handful of distribution certificates before refusing more.
# `match` keeps ONE certificate and its private key, and every runner
# restores the same pair.
#
# 🚨THIS FILE IS THE ONLY PLACE THAT KNOWS HOW TO SIGN. The CI files hand it
# raw secrets and stop at "run the lane", and the Mac lanes live here rather
# than in a second Fastfile for the same reason.

default_platform(:ios)

APP_IDENTIFIER = "com.myoun.anicel".freeze

# 🚨THE WEBSITE'S ADDRESS IS WRITTEN HERE AND NOWHERE ELSE. The site is its
# own repository, myoun99/anicel-site, on GitHub Pages — moved there on
# 2026-09-25 from this repository's docs/, which GitLab used to publish
# through the mirror. It lives apart from the code so its pages can be
# handed to people without a link to the source, and so the guide in it can
# be edited in the browser without committing to this repository.
#
# App Store Connect's Test Information kept two hand-typed copies of this
# address — the privacy policy and the marketing page — and both went on
# naming a dead site after the suspension took it down (2026-09-01). Moving
# only the privacy one left the marketing one dead (2026-09-11), so the beta
# lane writes every address it names from here.
SITE_URL = "https://myoun99.github.io/anicel-site/".freeze
PRIVACY_PAGE = "privacy.html".freeze

# .strip on every single-line secret: a value pasted with a trailing newline
# reaches CI intact, and the failure it causes names something else entirely.
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").strip,
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    in_house: false,
  )
end

# match clones the signing repository over HTTPS, so the token has to arrive
# the way git expects it — base64 of "user:token". It is built HERE: each CI
# step used to build it for itself, a third copy was about to appear with the
# Mac workflow, and a header that differs between copies is an auth failure
# that reads like a wrong token. Which username goes beside the token is the
# host's business — GitLab takes `oauth2`, GitHub wanted `x-access-token` —
# and MATCH_GIT_USER says which, `oauth2` when unset. pack("m0") is strict
# base64: no line wrap, and nothing to require.
def match_git_authorization
  user = ENV.fetch("MATCH_GIT_USER", "").strip
  user = "oauth2" if user.empty?
  ["#{user}:#{ENV.fetch('MATCH_GIT_TOKEN').strip}"].pack("m0")
end

# One identity out of the signing repository. readonly would be the safer
# setting, but it cannot create the pair that does not exist yet; setup_ci
# turns it on, so it is turned back off. match reaches for Apple only when
# the repository holds nothing of that type.
def signing_identity(key, type:, platform:, **options)
  match(
    api_key: key,
    type: type,
    platform: platform,
    app_identifier: APP_IDENTIFIER,
    git_url: ENV.fetch("MATCH_GIT_URL").strip,
    git_basic_authorization: match_git_authorization,
    storage_mode: "git",
    readonly: false,
    **options
  )
end

# ⛔DEVELOPER ID IS THE ONE IDENTITY MATCH CANNOT MINT. Asked through the API
# key, Apple answered "This operation can only be performed by the Account
# Holder" (Codemagic, 2026-09-11) — a rule about who asks, not about the
# key's role. The Account Holder makes the certificate once on
# developer.apple.com, and its .p12 arrives as two secrets: DEVELOPER_ID_P12
# (base64) and DEVELOPER_ID_P12_PASSWORD. It goes into the keychain setup_ci
# made, beside Apple's Developer ID intermediate, which a CI keychain does not
# carry and codesign needs to finish the chain.
#
# No provisioning profile: Developer ID needs one only for the entitlements
# Apple gates (iCloud, push), and this app asks for none of them — the
# sandbox, user-selected files, bookmarks and the microphone are granted by
# the signature alone.
require "tmpdir"

def import_developer_id
  keychain = ENV.fetch("MATCH_KEYCHAIN_NAME")
  keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
  Dir.mktmpdir do |dir|
    intermediate = File.join(dir, "DeveloperIDG2CA.cer")
    sh("curl", "-fsSL", "-o", intermediate,
       "https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer")
    import_certificate(
      certificate_path: intermediate,
      keychain_name: keychain,
      keychain_password: keychain_password,
    )
    p12 = File.join(dir, "developer_id.p12")
    File.binwrite(p12, ENV.fetch("DEVELOPER_ID_P12").unpack1("m"))
    import_certificate(
      certificate_path: p12,
      certificate_password: ENV.fetch("DEVELOPER_ID_P12_PASSWORD").strip,
      keychain_name: keychain,
      keychain_password: keychain_password,
    )
  end
end

require "net/http"

# The two pages App Store Connect names — the marketing page and the privacy
# policy — have to answer before a build goes out that points testers at
# them.
#
# ⚠️This used to compare the served site with docs/ byte for byte, because
# docs/ WAS the site and a mirror that stopped feeding it showed testers an
# old promise. The site is its own repository now and is edited there, so
# there is no copy here to compare with — only the question of whether the
# pages are up.
def ensure_site_answers
  [URI(SITE_URL), URI.join(SITE_URL, PRIVACY_PAGE)].each do |url|
    response = Net::HTTP.get_response(url)
    next if response.is_a?(Net::HTTPOK)

    UI.user_error!(
      "#{url} answers HTTP #{response.code}. App Store Connect names this " \
      "page; the site is myoun99/anicel-site on GitHub Pages — check that " \
      "its latest deployment passed.",
    )
  end
end

# Test Information in App Store Connect, one entry per language it is kept
# in, names the site twice: the marketing page and the privacy policy. Each
# entry is pointed at the pages above. The rest of it — the description, the
# feedback address, the reviewer's contact — is the Account Holder's to
# type, and is left alone.
def point_test_information_at_site
  wanted = {
    marketingUrl: SITE_URL,
    privacyPolicyUrl: URI.join(SITE_URL, PRIVACY_PAGE).to_s,
  }
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App Store Connect has no app #{APP_IDENTIFIER}") unless app
  localizations = app.get_beta_app_localizations
  if localizations.empty?
    UI.important("Test Information is empty: no site address to point")
  end
  localizations.each do |localization|
    current = {
      marketingUrl: localization.marketing_url,
      privacyPolicyUrl: localization.privacy_policy_url,
    }
    stale = wanted.reject { |field, url| current[field] == url }
    next if stale.empty?

    Spaceship::ConnectAPI.patch_beta_app_localizations(
      localization_id: localization.id,
      attributes: stale,
    )
    UI.message(
      "Test Information (#{localization.locale}) now names " \
      "#{stale.values.join(' and ')}",
    )
  end
end

platform :ios do
  desc "Build a signed .ipa and ship it to TestFlight"
  lane :beta do
    key = asc_key

    # What a tester is shown of the site, settled before anything is signed
    # or built: the pages answering, and App Store Connect naming them. A
    # build that would send testers to a dead page stops here.
    ensure_site_answers
    point_test_information_at_site

    # A CI keychain starts empty, and its password has to be one fastlane
    # knows — the default login keychain's is not.
    setup_ci

    signing_identity(key, type: "appstore", platform: "ios")

    # The profile's NAME comes from what match just installed, for the same
    # reason the team does below. A constant held only while nobody else
    # owned the name: when match starts over — a new signing repository, as
    # on 2026-09-10 — the old profile is still on Apple's side holding it
    # (invalid once its certificate is revoked, but not gone), and sigh
    # answers a taken name by appending a timestamp. The pinned settings
    # would then name a profile that is not on the machine.
    profile_name = ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name")

    # The team comes from the profile match just installed, not from a
    # secret: they have to agree, and only one of them is authoritative.
    # A stray newline in the secret is what made Xcode report "No profile
    # for team '<blank line>XXXX'" — the profile existed, the project was
    # asking for a team whose name had a line break in it.
    team_id = (
      ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"] ||
      ENV.fetch("FASTLANE_TEAM_ID")
    ).strip

    # Automatic signing would let Xcode pick its own identity and undo the
    # point of match, so the target is pinned to the profile match just
    # installed.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
    )

    # No increment_build_number here on purpose: CFBundleVersion resolves
    # to $(FLUTTER_BUILD_NUMBER), which Flutter writes into
    # Generated.xcconfig. agvtool would edit a field nothing reads. The
    # workflow passes --build-number to `flutter build` instead.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Anicel.ipa",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
      },
    )

    # Processing takes Apple several minutes; waiting for it would just
    # burn runner time. The build shows up in TestFlight on its own.
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :mac do
  # FIRST, AND ON ITS OWN, so a missing or mistyped secret costs a minute
  # rather than a build: the Mac workflow runs this before anything slow. It
  # was built to find out whether Apple would let the API key make the
  # certificate — Apple would not (see import_developer_id) — and it now
  # proves the Account Holder's certificate reached a keychain codesign reads.
  desc "Import the Developer ID identity and prove codesign can see it"
  lane :identity do
    setup_ci
    import_developer_id
    identities = sh("security", "find-identity", "-v", "-p", "codesigning",
                    log: false)
    unless identities.include?("Developer ID Application")
      UI.user_error!("no Developer ID Application identity in the keychain")
    end
  end

  # Direct distribution, as decided for the Mac: the Mac App Store was left
  # out of the app's registration, so the app is signed with Developer ID,
  # notarized by Apple, and handed over as a file.
  desc "Sign, notarize and zip the Mac app for direct distribution"
  lane :developer_id do
    # ⚠️ABSOLUTE PATHS, BECAUSE THIS FILE RUNS IN TWO DIRECTORIES. fastlane
    # runs actions from the project root (ios/) but the Fastfile's own code —
    # `sh` included — from ./fastlane, so a relative path means one thing to
    # build_mac_app and another to ditto. These are computed here, inside
    # ./fastlane, and mean the same thing to both.
    repo = File.expand_path("../..")
    output = File.join(repo, "ios", "build", "mac")

    key = asc_key
    setup_ci
    import_developer_id
    team_id = ENV.fetch("FASTLANE_TEAM_ID").strip

    # The project signs to run locally ("-") under automatic signing — right
    # for a developer's own Mac, wrong for a build anyone else will open. The
    # Runner target is pinned to Developer ID for this build only.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(repo, "macos", "Runner.xcodeproj"),
      team_id: team_id,
      code_sign_identity: "Developer ID Application",
      targets: ["Runner"],
    )

    # 🚨Notarization refuses a binary without the hardened runtime and a
    # secure timestamp, and the project asks for neither — turning them on
    # there would change every local Mac build to buy what only a
    # distributed one needs. They are asked for here, where distribution is.
    app = build_mac_app(
      workspace: File.join(repo, "macos", "Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      export_method: "developer-id",
      output_directory: output,
      xcargs: "ENABLE_HARDENED_RUNTIME=YES OTHER_CODE_SIGN_FLAGS=--timestamp",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Developer ID Application",
        teamID: team_id,
      },
    )
    unless app.to_s.end_with?(".app") && File.directory?(app.to_s)
      UI.user_error!("the export gave #{app.inspect}, not an .app in #{output}")
    end

    # Apple's verdict and its ticket, stapled into the app so Gatekeeper can
    # check it with no network. print_log shows Apple's findings either way.
    notarize(package: app, api_key: key, print_log: true)

    # ditto, not zip: it keeps the bundle's symlinks and extended attributes,
    # and an app that lost them no longer matches its own signature.
    sh("ditto", "-c", "-k", "--keepParent", app,
       File.join(output, "Anicel-macOS.zip"))
  end
end
