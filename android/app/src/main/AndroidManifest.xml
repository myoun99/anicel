<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SAVE-1c: the real-path model — projects live in the PUBLIC
         Documents folder and in sync-app mirror folders, both plain
         file paths. All-Files access is the desktop-like storage grant;
         the legacy pair covers pre-R devices. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- AUDIO-PRO R5: guide-voice recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- requestLegacyExternalStorage is Android 10 (API 29) ONLY, and
         ignored from 30 up: on 29 there is no MANAGE_EXTERNAL_STORAGE to
         ask for, and scoped storage hides the public Documents folder the
         project model is built on — so an API-29 tablet cannot open its
         own default folder without it. Anicel ships to old tablets on
         purpose, so the answer is the compatibility flag rather than
         raising minSdk past 29. (minSdk is 29 since 2026-10-24 — the
         devices below it render with Skia and are out of the release,
         skia-devices-out-of-release — so 29 is the one level it serves.) -->
    <application
        android:label="Anicel"
        android:name="${applicationName}"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask, not singleTop (open-door-android-share): a file
             handed while Anicel runs opens in the running one, as on
             Windows (open-door-windows-open-with-Q1, 유저 2026-10-22:
             「떠 있는 창의 새 탭으로」). An app that shares a file starts
             the app it shares with inside ITS OWN task, so under singleTop
             a second Anicel, a second engine in this process, would stand
             up there.
             ⚠️singleTask also closes what stands above Anicel in its task -
             a system picker or settings screen it opened - when Anicel is
             opened again from its icon (from Recents, it stays). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- open-door-android-share: what another app opens Anicel
                 with (VIEW) or shares with it (SEND, SEND_MULTIPLE) goes
                 through the one door a drop goes through - MainActivity
                 says it to Dart as a pick says it. A file of EVERY type
                 opens with it: the door's one judgement (openedAs) says
                 what Anicel opens and names what it does not, as for a
                 file the Explorer opens Anicel with. A type with no scheme
                 takes content: and file: alike. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!-- A share is every type but words (text/*): a link or a
                 sentence shared is text, with no file in it for the door
                 (open-door-android-share-Q1, 유저 2026-10-23: 「글 공유에는
                 안 뜨게」). A file shared as text - a program's shortcut
                 list (.txt) - opens with 「다음으로 열기」 instead. An item
                 typed */* still matches. ↩️Every type until then, as VIEW
                 takes. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="font/*"/>
            </intent-filter>
            <!-- A VIEW's data is the file it opens, not a route in the app:
                 Flutter reads it as one when this is absent (deep linking
                 is on unless switched off -
                 FlutterActivityLaunchConfigs.deepLinkEnabled). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- A frame's one picture is patched where it stands through Flutter
             GPU (one-picture-per-frame, D7-2-Q3 유저 2026-10-24) — off
             unless asked for; the engine reads this in release too
             (FlutterEngineFlags.ENABLE_FLUTTER_GPU). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableFlutterGPU"
            android:value="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
