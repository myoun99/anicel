+TEST(EmbedderSurfaceGLImpellerTest,
+     WhileItsContextIsLostNothingIsMadeCurrentAndNoThreadReacts) {
+  const auto context = std::make_shared<ContextOfTheEmbedder>();
+  auto surface = EmbedderSurfaceGLImpeller(
+      DispatchTableOver(context), /* fbo_reset_after_present */ false,
+      /* external_view_embedder */ nullptr);
+  GPUSurfaceGLDelegate& delegate = surface;
+  EmbedderSurface& embedder_surface = surface;
+  const auto reactor = ReactorOf(surface);
+
+  // Two threads react: this one, as the raster thread does, and another the
+  // resource context is current on.
+  ASSERT_TRUE(delegate.GLContextMakeCurrent()->GetResult());
+  ASSERT_TRUE(reactor->CanReactOnCurrentThread());
+  fml::AutoResetWaitableEvent the_resource_context_is_current;
+  fml::AutoResetWaitableEvent the_context_is_lost;
+  bool the_other_thread_reacted_before = false;
+  bool the_other_thread_reacts_after = true;
+  int cleared_before_the_other_thread_released = -1;
+  int cleared_after_the_other_thread_released = -1;
+  std::thread the_other_thread([&] {
+    embedder_surface.CreateResourceContext();
+    the_other_thread_reacted_before = reactor->CanReactOnCurrentThread();
+    the_resource_context_is_current.Signal();
+    the_context_is_lost.Wait();
+    the_other_thread_reacts_after = reactor->CanReactOnCurrentThread();
+    cleared_before_the_other_thread_released = context->asked_to_be_cleared;
+    embedder_surface.ReleaseResourceContext();
+    cleared_after_the_other_thread_released = context->asked_to_be_cleared;
+  });
+  the_resource_context_is_current.Wait();
+  const int asked_before = context->asked_to_be_made_current;
+  // The surface cleared once already, as it was made.
+  const int cleared_before = context->asked_to_be_cleared;
+
+  EXPECT_TRUE(embedder_surface.GLContextLost());
+  // The lost context is taken off the thread the surface let go on...
+  EXPECT_EQ(context->asked_to_be_cleared, cleared_before + 1);
+  the_context_is_lost.Signal();
+  the_other_thread.join();
+
+  EXPECT_TRUE(the_other_thread_reacted_before);
+  EXPECT_FALSE(the_other_thread_reacts_after);
+  // ...and the resource context off the thread that releases it.
+  EXPECT_EQ(cleared_before_the_other_thread_released, cleared_before + 1);
+  EXPECT_EQ(cleared_after_the_other_thread_released, cleared_before + 2);
+  EXPECT_FALSE(reactor->CanReactOnCurrentThread());
+  // The embedder is not asked for the context that went.
+  EXPECT_FALSE(delegate.GLContextMakeCurrent()->GetResult());
+  EXPECT_EQ(context->asked_to_be_made_current, asked_before);
+  EXPECT_FALSE(reactor->CanReactOnCurrentThread());
+}
