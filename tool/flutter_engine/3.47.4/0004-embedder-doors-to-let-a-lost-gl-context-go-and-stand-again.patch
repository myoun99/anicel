+// [anicel 0004] The embedder's OpenGL context is lost and made anew under the
+// surface (FlutterEngineNotifyGLContextLost, ...Restored).
+
+namespace {
+// The embedder's context as a test sets it, and what was asked of it.
+struct ContextOfTheEmbedder {
+  bool can_be_made_current = true;
+  int asked_to_be_made_current = 0;
+  // Asked of more threads than one.
+  std::atomic<int> asked_to_be_cleared = 0;
+};
+
+EmbedderSurfaceGLSkia::GLDispatchTable DispatchTableOver(
+    const std::shared_ptr<ContextOfTheEmbedder>& context) {
+  auto table = StubDispatchTable(/* version */ "OpenGL ES 3.0");
+  table.gl_make_current_callback = [context] {
+    context->asked_to_be_made_current += 1;
+    return context->can_be_made_current;
+  };
+  table.gl_clear_current_callback = [context] {
+    context->asked_to_be_cleared += 1;
+    return true;
+  };
+  return table;
+}
+
+std::shared_ptr<impeller::ReactorGLES> ReactorOf(
+    const EmbedderSurface& surface) {
+  return impeller::ContextGLES::Cast(*surface.CreateImpellerContext())
+      .GetReactor();
+}
+
+impeller::HandleGLES NameATexture(
+    const std::shared_ptr<impeller::ReactorGLES>& reactor) {
+  return reactor->CreateUntrackedHandle(impeller::HandleType::kTexture);
+}
