+TEST(EmbedderSurfaceGLImpellerTest,
+     AThreadReactsOnlyWhereItsContextWasMadeCurrent) {
+  const auto context = std::make_shared<ContextOfTheEmbedder>();
+  auto surface = EmbedderSurfaceGLImpeller(
+      DispatchTableOver(context), /* fbo_reset_after_present */ false,
+      /* external_view_embedder */ nullptr);
+  GPUSurfaceGLDelegate& delegate = surface;
+  const auto reactor = ReactorOf(surface);
+
+  context->can_be_made_current = false;
+  EXPECT_FALSE(delegate.GLContextMakeCurrent()->GetResult());
+  EXPECT_FALSE(reactor->CanReactOnCurrentThread());
+
+  context->can_be_made_current = true;
+  EXPECT_TRUE(delegate.GLContextMakeCurrent()->GetResult());
+  EXPECT_TRUE(reactor->CanReactOnCurrentThread());
+
+  // And no longer, once the context was refused again.
+  context->can_be_made_current = false;
+  EXPECT_FALSE(delegate.GLContextMakeCurrent()->GetResult());
+  EXPECT_FALSE(reactor->CanReactOnCurrentThread());
+}
