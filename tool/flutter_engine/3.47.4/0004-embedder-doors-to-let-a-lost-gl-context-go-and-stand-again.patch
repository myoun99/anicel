+TEST(EmbedderSurfaceGLImpellerTest,
+     NoPipelineAskedForOfTheLostContextIsHandedOutAgain) {
+  const auto context = std::make_shared<ContextOfTheEmbedder>();
+  auto surface = EmbedderSurfaceGLImpeller(
+      DispatchTableOver(context), /* fbo_reset_after_present */ false,
+      /* external_view_embedder */ nullptr);
+  EmbedderSurface& embedder_surface = surface;
+  const std::shared_ptr<impeller::Context> impeller_context =
+      embedder_surface.CreateImpellerContext();
+  const std::shared_ptr<impeller::ShaderLibrary> shaders =
+      impeller_context->GetShaderLibrary();
+  impeller::PipelineDescriptor descriptor;
+  descriptor.AddStageEntrypoint(shaders->GetFunction(
+      "imp_line_vertex_main", impeller::ShaderStage::kVertex));
+  descriptor.AddStageEntrypoint(shaders->GetFunction(
+      "imp_line_fragment_main", impeller::ShaderStage::kFragment));
+  ASSERT_NE(descriptor.GetEntrypointForStage(impeller::ShaderStage::kVertex),
+            nullptr);
+  ASSERT_NE(
+      descriptor.GetEntrypointForStage(impeller::ShaderStage::kFragment),
+      nullptr);
+  const std::shared_ptr<impeller::PipelineLibrary> library =
+      impeller_context->GetPipelineLibrary();
+
+  // Asked for on a thread whose context was never made current: its linking
+  // waits there, so nothing of the mock's OpenGL is run.
+  const auto asked_of_the_lost_context = library->GetPipeline(descriptor);
+  ASSERT_TRUE(library->HasPipeline(descriptor));
+  ASSERT_TRUE(embedder_surface.GLContextLost());
+  // The lost context's still, until a context stands in its place.
+  EXPECT_TRUE(library->HasPipeline(descriptor));
+
+  ASSERT_TRUE(embedder_surface.GLContextRestored());
+
+  // Its linking went with the lost context (ReactorGLES::GLContextWasReplaced
+  // lets the waiting work go), so it would never come.
+  EXPECT_FALSE(library->HasPipeline(descriptor));
+}
