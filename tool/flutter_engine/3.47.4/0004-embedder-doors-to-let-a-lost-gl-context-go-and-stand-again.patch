+  EXPECT_FALSE(embedder_surface.GLContextRestored());
+  EXPECT_FALSE(reactor->IsOfReplacedContext(of_the_lost_context));
+  EXPECT_FALSE(reactor->CanReactOnCurrentThread());
+  EXPECT_FALSE(delegate.GLContextMakeCurrent()->GetResult());
