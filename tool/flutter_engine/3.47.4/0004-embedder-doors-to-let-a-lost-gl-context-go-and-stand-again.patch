+bool EmbedderEngine::NotifyGLContextLost() {
+  if (!IsValid()) {
+    return false;
+  }
+
+  // The platform view of an embedder's shell is the embedder's own:
+  // embedder.cc makes no other.
+  auto* platform_view =
+      static_cast<PlatformViewEmbedder*>(shell_->GetPlatformView().get());
+
+  // [anicel 0004] THE SURFACE LETS GO FIRST, and only then is the rasterizer
+  // torn down: its teardown asks for the context to be made current, and the
+  // surface that knows the context is lost refuses without asking the
+  // embedder. So nothing the teardown does reaches OpenGL -- which is also
+  // why the textures are told here that their context goes: the teardown
+  // tells them only where the context could be made current.
+  bool let_go = false;
+  fml::AutoResetWaitableEvent latch;
+  fml::TaskRunner::RunNowOrPostTask(
+      task_runners_.GetRasterTaskRunner(),
+      [&let_go, &latch, platform_view, rasterizer = shell_->GetRasterizer()] {
+        let_go = platform_view->GLContextLost();
+        if (let_go && rasterizer) {
+          rasterizer->GetTextureRegistry()->OnGrContextDestroyed();
+        }
+        latch.Signal();
+      });
+  latch.Wait();
+  if (!let_go) {
+    return false;
+  }
+
+  // What the rasterizer built in the lost context goes with its surface. The
+  // IO thread is waited for as well: what it was doing as the context went is
+  // done by the time this returns, and it reacts no more.
+  platform_view->NotifyDestroyed();
+
+  // The raster thread gave its context up as the surface let go; the IO
+  // thread gives up the resource context here, now that it is idle. No thread
+  // of the engine has a context current once this returns.
+  fml::AutoResetWaitableEvent io_latch;
+  fml::TaskRunner::RunNowOrPostTask(task_runners_.GetIOTaskRunner(),
+                                    [&io_latch, platform_view] {
+                                      platform_view->ReleaseGLResourceContext();
+                                      io_latch.Signal();
+                                    });
+  io_latch.Wait();
+  return true;
+}
+
+bool EmbedderEngine::NotifyGLContextRestored() {
+  if (!IsValid()) {
+    return false;
+  }
+
+  auto* platform_view =
+      static_cast<PlatformViewEmbedder*>(shell_->GetPlatformView().get());
+
+  bool stands_again = false;
+  fml::AutoResetWaitableEvent latch;
+  fml::TaskRunner::RunNowOrPostTask(
+      task_runners_.GetRasterTaskRunner(),
+      [&stands_again, &latch, platform_view] {
+        stands_again = platform_view->GLContextRestored();
+        latch.Signal();
+      });
+  latch.Wait();
+  if (!stands_again) {
+    return false;
+  }
+
+  // The rendering surface is built in the context made anew, the resource
+  // context is made current on the IO thread, and a frame is scheduled: the
+  // same steps as when the engine first ran.
+  platform_view->NotifyCreated();
+  return true;
+}
