+TEST(EmbedderSurfaceGLImpellerTest,
+     ItStandsAgainInTheContextMadeAnewAndWhatTheLostOneNamedNamesNothing) {
+  const auto context = std::make_shared<ContextOfTheEmbedder>();
+  auto surface = EmbedderSurfaceGLImpeller(
+      DispatchTableOver(context), /* fbo_reset_after_present */ false,
+      /* external_view_embedder */ nullptr);
+  GPUSurfaceGLDelegate& delegate = surface;
+  EmbedderSurface& embedder_surface = surface;
+  const auto reactor = ReactorOf(surface);
+
+  ASSERT_TRUE(delegate.GLContextMakeCurrent()->GetResult());
+  const impeller::HandleGLES of_the_lost_context = NameATexture(reactor);
+  ASSERT_TRUE(embedder_surface.GLContextLost());
+  // Nothing stands in the lost context's place yet: Impeller still counts by
+  // it, so that what a thread named as the context went is counted to it.
+  EXPECT_FALSE(reactor->IsOfReplacedContext(of_the_lost_context));
+
+  EXPECT_TRUE(embedder_surface.GLContextRestored());
+
+  EXPECT_TRUE(reactor->IsOfReplacedContext(of_the_lost_context));
+  EXPECT_TRUE(reactor->CanReactOnCurrentThread());
+  EXPECT_TRUE(delegate.GLContextMakeCurrent()->GetResult());
+  EXPECT_FALSE(reactor->IsOfReplacedContext(NameATexture(reactor)));
+}
