-      return std::chrono::high_resolution_clock::now() >= next_fire_time_ ||
-             callback_ == nullptr;
-    });
+    cv_.wait_until(lock, next_fire_time_);
+    if (next_fire_time_ > std::chrono::high_resolution_clock::now()) {
