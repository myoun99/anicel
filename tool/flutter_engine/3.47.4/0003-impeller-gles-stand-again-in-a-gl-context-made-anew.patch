+
+// [anicel 0003] The OpenGL context under a reactor was lost and another
+// stands in its place (ReactorGLES::GLContextWasReplaced): what was made
+// under the old one names nothing and deletes nothing, a buffer stands again
+// whole, and a texture stands again empty.
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "flutter/testing/testing.h"  // IWYU pragma: keep
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "impeller/base/allocation.h"
+#include "impeller/core/formats.h"
+#include "impeller/core/texture_descriptor.h"
+#include "impeller/renderer/backend/gles/device_buffer_gles.h"
+#include "impeller/renderer/backend/gles/handle_gles.h"
+#include "impeller/renderer/backend/gles/proc_table_gles.h"
+#include "impeller/renderer/backend/gles/reactor_gles.h"
+#include "impeller/renderer/backend/gles/test/mock_gles.h"
+#include "impeller/renderer/backend/gles/texture_gles.h"
+
+namespace impeller {
+namespace testing {
+
+using ::testing::_;
+using ::testing::AnyNumber;
+using ::testing::NiceMock;
+using ::testing::Pointee;
+
+namespace {
+
+// A thread its OpenGL context is current on, until told it is not.
+class TestWorker : public ReactorGLES::Worker {
+ public:
+  bool CanReactorReactOnCurrentThreadNow(
+      const ReactorGLES& reactor) const override {
+    return can_react;
+  }
+
+  bool can_react = true;
+};
+
+struct Rig {
+  // Owned by `mock`.
+  NiceMock<MockGLESImpl>* gl = nullptr;
+  std::shared_ptr<MockGLES> mock;
+  std::shared_ptr<TestWorker> worker;
+  std::shared_ptr<ReactorGLES> reactor;
+};
+
+Rig MakeRig() {
+  Rig rig;
+  auto gl = std::make_unique<NiceMock<MockGLESImpl>>();
+  rig.gl = gl.get();
+  rig.mock = MockGLES::Init(std::move(gl));
+  ProcTableGLES::Resolver resolver = kMockResolverGLES;
+  rig.worker = std::make_shared<TestWorker>();
+  rig.reactor =
+      std::make_shared<ReactorGLES>(std::make_unique<ProcTableGLES>(resolver));
+  rig.reactor->AddWorker(rig.worker);
+  return rig;
+}
+
+// Runs what the reactor has pending, deletions among it.
+void React(const Rig& rig) {
+  ASSERT_TRUE(rig.reactor->AddOperation([](const ReactorGLES&) {}));
+  ASSERT_TRUE(rig.reactor->React());
+}
+
+TextureDescriptor FourByTwo() {
+  TextureDescriptor desc;
+  desc.storage_mode = StorageMode::kDevicePrivate;
+  desc.format = PixelFormat::kR8G8B8A8UNormInt;
+  desc.size = {4, 2};
+  return desc;
+}
+
+// What a texture's storage was given with.
+enum class Given { kNoData, kZeros, kOtherData };
+
+}  // namespace
+
+TEST(GLContextReplacedTest,
+     AHandleOfTheOldContextNamesNothingAndDeletesNothing) {
+  Rig rig = MakeRig();
+  GLuint next = 100;
+  ON_CALL(*rig.gl, GenTextures(1, _))
+      .WillByDefault([&](GLsizei, GLuint* textures) { textures[0] = next++; });
+  // Until the handle made in the new context is collected, below.
+  EXPECT_CALL(*rig.gl, DeleteTextures(_, _)).Times(0);
+
+  HandleGLES tracked = rig.reactor->CreateHandle(HandleType::kTexture);
+  HandleGLES untracked =
+      rig.reactor->CreateUntrackedHandle(HandleType::kTexture);
+  ASSERT_EQ(rig.reactor->GetGLHandle(tracked), std::optional<GLuint>(100u));
+  ASSERT_EQ(rig.reactor->GetGLHandle(untracked), std::optional<GLuint>(101u));
+  EXPECT_FALSE(rig.reactor->IsOfReplacedContext(tracked));
+  EXPECT_FALSE(rig.reactor->IsOfReplacedContext(untracked));
+  bool ran = false;
+  ASSERT_TRUE(rig.reactor->AddOperation(
+      [&](const ReactorGLES&) { ran = true; }, /*defer=*/true));
+
+  // The new context numbers its objects from where the old one began: the
+  // old numbers name its objects now.
+  next = 100;
+  rig.reactor->GLContextWasReplaced();
+
+  EXPECT_TRUE(rig.reactor->IsOfReplacedContext(tracked));
+  EXPECT_TRUE(rig.reactor->IsOfReplacedContext(untracked));
+  EXPECT_FALSE(rig.reactor->GetGLHandle(tracked).has_value());
+  EXPECT_FALSE(rig.reactor->GetGLHandle(untracked).has_value());
+
+  HandleGLES made_after =
+      rig.reactor->CreateUntrackedHandle(HandleType::kTexture);
+  EXPECT_FALSE(rig.reactor->IsOfReplacedContext(made_after));
+  EXPECT_EQ(rig.reactor->GetGLHandle(made_after), std::optional<GLuint>(100u));
+
+  // Collected, the old two delete nothing — 100 is the new context's.
+  rig.reactor->CollectHandle(tracked);
+  rig.reactor->CollectHandle(untracked);
+  React(rig);
+  EXPECT_FALSE(ran) << "an operation for the old context ran in the new one";
+  ::testing::Mock::VerifyAndClearExpectations(rig.gl);
+
+  // And a handle of the context that stands deletes its own, as ever.
+  EXPECT_CALL(*rig.gl, DeleteTextures(1, Pointee(100u))).Times(1);
+  rig.reactor->CollectHandle(made_after);
+  React(rig);
+}
+
+TEST(GLContextReplacedTest, ADeadHandleIsOfNoContext) {
+  Rig rig = MakeRig();
+  rig.reactor->GLContextWasReplaced();
+  EXPECT_FALSE(rig.reactor->IsOfReplacedContext(HandleGLES::DeadHandle()));
+}
+
+TEST(GLContextReplacedTest, ACleanupCallbackRunsAsItsHandleGoesWithTheContext) {
+  Rig rig = MakeRig();
+  int ran = 0;
+  HandleGLES handle = rig.reactor->CreateHandle(HandleType::kTexture, 1123);
+  ASSERT_TRUE(rig.reactor->RegisterCleanupCallback(handle, [&]() { ran++; }));
+
+  rig.reactor->GLContextWasReplaced();
+
+  EXPECT_EQ(ran, 1);
+}
+
+TEST(GLContextReplacedTest, ABufferStandsAgainWholeInTheNewContext) {
+  Rig rig = MakeRig();
+  GLuint next = 7;
+  ON_CALL(*rig.gl, GenBuffers(1, _))
+      .WillByDefault([&](GLsizei, GLuint* buffers) { buffers[0] = next++; });
+  std::vector<std::pair<GLintptr, GLsizeiptr>> uploads;
+  ON_CALL(*rig.gl, BufferSubData(_, _, _, _))
+      .WillByDefault(
+          [&](GLenum, GLintptr offset, GLsizeiptr size, const void*) {
+            uploads.emplace_back(offset, size);
+          });
+  EXPECT_CALL(*rig.gl, DeleteBuffers(_, _)).Times(AnyNumber());
+  // The old context's: never deleted in the new one.
+  EXPECT_CALL(*rig.gl, DeleteBuffers(1, Pointee(7u))).Times(0);
+
+  auto backing_store = std::make_unique<Allocation>();
+  ASSERT_TRUE(backing_store->Truncate(Bytes{16}));
+  auto buffer = std::make_unique<DeviceBufferGLES>(
+      DeviceBufferDescriptor{.size = 16}, rig.reactor,
+      std::move(backing_store));
+  buffer->Flush(Range{0, 4});
+  ASSERT_TRUE(buffer->BindAndUploadDataIfNecessary(
+      DeviceBufferGLES::BindingType::kArrayBuffer));
+  ASSERT_EQ(buffer->GetHandle(), std::optional<GLuint>(7u));
+  ASSERT_EQ(uploads,
+            (std::vector<std::pair<GLintptr, GLsizeiptr>>{{0, 4}}));
+  uploads.clear();
+
+  rig.reactor->GLContextWasReplaced();
+
+  EXPECT_FALSE(buffer->GetHandle().has_value());
+  ASSERT_TRUE(buffer->BindAndUploadDataIfNecessary(
+      DeviceBufferGLES::BindingType::kArrayBuffer));
+  EXPECT_EQ(buffer->GetHandle(), std::optional<GLuint>(8u));
+  // All sixteen bytes, though none was written since the first upload.
+  EXPECT_EQ(uploads,
+            (std::vector<std::pair<GLintptr, GLsizeiptr>>{{0, 16}}));
+
+  buffer.reset();
+  React(rig);
+}
+
+TEST(GLContextReplacedTest, ATextureStandsAgainEmptyInTheNewContext) {
+  Rig rig = MakeRig();
+  GLuint next = 40;
+  ON_CALL(*rig.gl, GenTextures(1, _))
+      .WillByDefault([&](GLsizei, GLuint* textures) { textures[0] = next++; });
+  std::vector<GLuint> bound;
+  ON_CALL(*rig.gl, BindTexture(_, _))
+      .WillByDefault([&](GLenum, GLuint texture) { bound.push_back(texture); });
+  std::vector<std::pair<GLuint, Given>> storage;
+  ON_CALL(*rig.gl, TexImage2D(_, _, _, _, _, _, _, _, _))
+      .WillByDefault([&](GLenum, GLint, GLint, GLsizei width, GLsizei height,
+                         GLint, GLenum, GLenum, const void* pixels) {
+        Given given = Given::kNoData;
+        if (pixels != nullptr) {
+          given = Given::kZeros;
+          const auto* bytes = static_cast<const uint8_t*>(pixels);
+          for (GLsizei i = 0; i < width * height * 4; i++) {
+            if (bytes[i] != 0) {
+              given = Given::kOtherData;
+            }
+          }
+        }
+        storage.emplace_back(bound.empty() ? 0u : bound.back(), given);
+      });
+  EXPECT_CALL(*rig.gl, DeleteTextures(_, _)).Times(AnyNumber());
+  // The old context's: never deleted in the new one.
+  EXPECT_CALL(*rig.gl, DeleteTextures(1, Pointee(40u))).Times(0);
+
+  auto texture = std::make_shared<TextureGLES>(rig.reactor, FourByTwo());
+  ASSERT_TRUE(texture->IsValid());
+  ASSERT_TRUE(texture->Bind());
+  ASSERT_EQ(texture->GetGLHandle(), std::optional<GLuint>(40u));
+  ASSERT_EQ(storage,
+            (std::vector<std::pair<GLuint, Given>>{{40u, Given::kNoData}}));
+  bound.clear();
+  storage.clear();
+
+  next = 90;
+  rig.reactor->GLContextWasReplaced();
+
+  ASSERT_TRUE(texture->Bind());
+  EXPECT_EQ(texture->GetGLHandle(), std::optional<GLuint>(90u));
+  for (GLuint name : bound) {
+    EXPECT_EQ(name, 90u) << "a name of the old context was bound";
+  }
+  EXPECT_FALSE(bound.empty());
+  EXPECT_EQ(storage,
+            (std::vector<std::pair<GLuint, Given>>{{90u, Given::kZeros}}));
+
+  // Once: from here on it is a texture of the context that stands.
+  storage.clear();
+  ASSERT_TRUE(texture->Bind());
+  EXPECT_TRUE(storage.empty());
+
+  texture.reset();
+  React(rig);
+}
+
+TEST(GLContextReplacedTest,
+     ATextureReachedForWhereNoContextIsCurrentStandsAgainAtTheNextReaction) {
+  Rig rig = MakeRig();
+  GLuint next = 40;
+  ON_CALL(*rig.gl, GenTextures(1, _))
+      .WillByDefault([&](GLsizei, GLuint* textures) { textures[0] = next++; });
+
+  auto texture = std::make_shared<TextureGLES>(rig.reactor, FourByTwo());
+  ASSERT_EQ(texture->GetGLHandle(), std::optional<GLuint>(40u));
+
+  next = 90;
+  rig.reactor->GLContextWasReplaced();
+
+  // The UI thread, say: it holds the image and no OpenGL context. The
+  // texture takes a handle there, and its name at the next reaction.
+  rig.worker->can_react = false;
+  EXPECT_FALSE(texture->IsSliceInitialized(0));
+  rig.worker->can_react = true;
+  React(rig);
+  EXPECT_EQ(texture->GetGLHandle(), std::optional<GLuint>(90u));
+}
+
+TEST(GLContextReplacedTest, WhatHungOnATextureOfTheOldContextGoesWithIt) {
+  Rig rig = MakeRig();
+  EXPECT_CALL(*rig.gl, DeleteFramebuffers(_, _)).Times(0);
+
+  auto texture = std::make_shared<TextureGLES>(rig.reactor, FourByTwo());
+  texture->SetCachedFBO(
+      rig.reactor->CreateUntrackedHandle(HandleType::kFrameBuffer));
+  texture->MarkSliceInitialized(0);
+  ASSERT_FALSE(texture->GetCachedFBO().IsDead());
+  ASSERT_TRUE(texture->IsSliceInitialized(0));
+
+  rig.reactor->GLContextWasReplaced();
+
+  // No framebuffer of the old context is handed to a pass of the new one,
+  // and none is deleted in it; and its storage is to be given again.
+  EXPECT_TRUE(texture->GetCachedFBO().IsDead());
+  EXPECT_FALSE(texture->IsSliceInitialized(0));
+  React(rig);
+  ::testing::Mock::VerifyAndClearExpectations(rig.gl);
+}
+
+TEST(GLContextReplacedTest,
+     WhatWrapsAnothersTextureOfTheOldContextBindsNoneAndStillBinds) {
+  Rig rig = MakeRig();
+  std::vector<GLuint> bound;
+  ON_CALL(*rig.gl, BindTexture(_, _))
+      .WillByDefault([&](GLenum, GLuint texture) { bound.push_back(texture); });
+  EXPECT_CALL(*rig.gl, DeleteTextures(_, _)).Times(0);
+
+  TextureDescriptor desc = FourByTwo();
+  auto wrapper = TextureGLES::WrapTexture(
+      rig.reactor, desc, rig.reactor->CreateHandle(HandleType::kTexture, 555));
+  ASSERT_TRUE(wrapper);
+  ASSERT_TRUE(wrapper->Bind());
+  ASSERT_EQ(bound, std::vector<GLuint>{555u});
+  bound.clear();
+
+  rig.reactor->GLContextWasReplaced();
+
+  // ⛔Not a failed bind: a pass whose textures do not bind ends the process.
+  EXPECT_TRUE(wrapper->Bind());
+  EXPECT_EQ(bound, std::vector<GLuint>{0u});
+
+  wrapper.reset();
+  React(rig);
+  ::testing::Mock::VerifyAndClearExpectations(rig.gl);
+}
