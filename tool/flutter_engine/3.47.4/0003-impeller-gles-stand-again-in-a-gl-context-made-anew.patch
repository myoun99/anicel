+void ReactorGLES::GLContextWasReplaced() {
+  // Let go of outside the locks: a handle's cleanup callback and what an
+  // operation captured may come back to the reactor as they go.
+  LiveHandles handles_of_the_old_context;
+  decltype(ops_) ops_for_the_old_context;
+  {
+    WriterLock handles_lock(handles_mutex_);
+    // Nothing is deleted: the names went with the context they were made in.
+    std::swap(handles_of_the_old_context, handles_);
+    handles_to_collect_count_ = 0;
+    context_generation_ += 1;
+  }
+  {
+    Lock ops_lock(ops_mutex_);
+    std::swap(ops_for_the_old_context, ops_);
+  }
+}
