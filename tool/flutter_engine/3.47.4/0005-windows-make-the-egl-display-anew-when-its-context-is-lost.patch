+// A running engine with one view, over mocks that write down what was asked
+// of them and in what order.
+struct RestoringEngine {
+  std::vector<std::string> steps;
+  std::unique_ptr<NiceMock<MockFlutterWindowsEngine>> engine;
+  NiceMock<egl::MockManager>* egl_manager = nullptr;
+  NiceMock<egl::MockWindowSurface>* surface_of_the_lost_display = nullptr;
+  FlutterEngineResult the_engine_lets_go = kSuccess;
+  FlutterEngineResult the_engine_stands_again = kSuccess;
+  std::unique_ptr<FlutterWindowsView> view;
+
+  explicit RestoringEngine(bool the_view_has_a_surface = true) {
+    engine = std::make_unique<NiceMock<MockFlutterWindowsEngine>>(
+        std::make_shared<NiceMock<MockWindowsProcTable>>());
+    ON_CALL(*engine, running).WillByDefault(Return(true));
+    ON_CALL(*engine, PostRasterThreadTask)
+        .WillByDefault([](fml::closure callback) {
+          callback();
+          return true;
+        });
+
+    EngineModifier modifier{engine.get()};
+
+    auto compositor = std::make_unique<NiceMock<MockCompositor>>();
+    ON_CALL(*compositor, GLContextLost).WillByDefault([this] {
+      steps.push_back("the compositor hears");
+    });
+    modifier.SetCompositor(std::move(compositor));
+
+    auto manager = std::make_unique<NiceMock<egl::MockManager>>();
+    egl_manager = manager.get();
+    ON_CALL(*egl_manager, MakeAnew).WillByDefault([this] {
+      steps.push_back("the display is made anew");
+      return true;
+    });
+    modifier.SetEGLManager(std::move(manager));
+
+    modifier.embedder_api().NotifyGLContextLost =
+        MOCK_ENGINE_PROC(NotifyGLContextLost, ([this](auto engine) {
+                           steps.push_back("the engine lets go");
+                           return the_engine_lets_go;
+                         }));
+    modifier.embedder_api().NotifyGLContextRestored =
+        MOCK_ENGINE_PROC(NotifyGLContextRestored, ([this](auto engine) {
+                           steps.push_back("the engine stands again");
+                           return the_engine_stands_again;
+                         }));
+
+    // The view's first surface, of the display that is to be lost.
+    if (the_view_has_a_surface) {
+      auto surface = std::make_unique<NiceMock<egl::MockWindowSurface>>();
+      surface_of_the_lost_display = surface.get();
+      ON_CALL(*surface_of_the_lost_display, Abandon).WillByDefault([this] {
+        steps.push_back("the view forgets its surface");
+      });
+      EXPECT_CALL(*egl_manager, CreateWindowSurface)
+          .WillOnce(Return(::testing::ByMove(
+              std::unique_ptr<flutter::egl::WindowSurface>(
+                  std::move(surface)))));
+    } else {
+      EXPECT_CALL(*egl_manager, CreateWindowSurface)
+          .WillOnce(Return(::testing::ByMove(
+              std::unique_ptr<flutter::egl::WindowSurface>())));
+    }
+    view = engine->CreateView(
+        std::make_unique<NiceMock<MockWindowBindingHandler>>(),
+        /*is_sized_to_content=*/false, BoxConstraints());
+    ::testing::Mock::VerifyAndClearExpectations(egl_manager);
+  }
+
+  // The surface the view asks for once the display was made anew.
+  void ExpectASurfaceOfTheDisplayMadeAnew() {
+    EXPECT_CALL(*egl_manager, CreateWindowSurface)
+        .WillOnce([this](HWND, size_t, size_t)
+                      -> std::unique_ptr<flutter::egl::WindowSurface> {
+          steps.push_back("the view gets a surface");
+          return std::make_unique<NiceMock<egl::MockWindowSurface>>();
+        });
