+  ON_CALL(*rig.egl_manager, MakeAnew).WillByDefault([&rig] {
+    rig.steps.push_back("the display is not made anew");
+    return false;
+  });
+  EXPECT_CALL(*rig.egl_manager, CreateWindowSurface).Times(0);
+
+  EXPECT_FALSE(rig.engine->RestoreGLContext());
+
+  EXPECT_THAT(rig.steps, ::testing::ElementsAre(
+                             "the compositor hears", "the engine lets go",
+                             "the view forgets its surface",
+                             "the display is not made anew"));
+}
+
+TEST(RestoreGLContextTest, WhereTheEngineDoesNotStandAgainItIsNotRestored) {
+  RestoringEngine rig;
+  rig.the_engine_stands_again = kInternalInconsistency;
+  rig.ExpectASurfaceOfTheDisplayMadeAnew();
+
+  EXPECT_FALSE(rig.engine->RestoreGLContext());
+}
+
+TEST(RestoreGLContextTest, AViewThatHadNoSurfaceGetsNone) {
+  RestoringEngine rig{/*the_view_has_a_surface=*/false};
+  EXPECT_CALL(*rig.egl_manager, CreateWindowSurface).Times(0);
+
+  EXPECT_TRUE(rig.engine->RestoreGLContext());
+
+  EXPECT_THAT(rig.steps, ::testing::ElementsAre(
+                             "the compositor hears", "the engine lets go",
+                             "the display is made anew",
+                             "the engine stands again"));
+}
+
 }  // namespace testing
 }  // namespace flutter
