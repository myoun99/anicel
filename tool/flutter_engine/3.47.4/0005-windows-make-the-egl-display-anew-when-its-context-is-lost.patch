+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// [anicel 0005] A lost context is said once a loss, to the handler the
+// engine set, and said again only once the loss before it was answered.
+
+#include "flutter/shell/platform/windows/egl/egl.h"
+
+#include "gtest/gtest.h"
+
+namespace flutter {
+namespace testing {
+
+namespace {
+
+// Counts the losses the handler heard, and takes the handler back as the
+// test ends. Every test begins with no loss at hand.
+class ContextLostHandlerTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    flutter::egl::SetContextLostHandler(nullptr);
+    flutter::egl::TellContextRestored(true);
+    flutter::egl::SetContextLostHandler([this] { heard_ += 1; });
+  }
+
+  void TearDown() override {
+    flutter::egl::SetContextLostHandler(nullptr);
+    flutter::egl::TellContextRestored(true);
+  }
+
+  int heard() const { return heard_; }
+
+ private:
+  int heard_ = 0;
+};
+
+}  // namespace
+
+TEST_F(ContextLostHandlerTest, ALossIsSaidOnce) {
+  flutter::egl::ContextWasLost();
+  flutter::egl::ContextWasLost();
+
+  EXPECT_EQ(heard(), 1);
+}
+
+TEST_F(ContextLostHandlerTest, TheNextLossIsSaidOnceTheOneBeforeWasRestored) {
+  flutter::egl::ContextWasLost();
+  flutter::egl::TellContextRestored(true);
+  flutter::egl::ContextWasLost();
+
+  EXPECT_EQ(heard(), 2);
+}
+
+TEST_F(ContextLostHandlerTest, NoLossIsSaidAfterOneThatWasNotRestored) {
+  flutter::egl::ContextWasLost();
+  flutter::egl::TellContextRestored(false);
+  flutter::egl::ContextWasLost();
+
+  EXPECT_EQ(heard(), 1);
+}
+
+TEST_F(ContextLostHandlerTest, AHandlerTakenBackIsNotCalled) {
+  flutter::egl::SetContextLostHandler(nullptr);
+
+  flutter::egl::ContextWasLost();
+
+  EXPECT_EQ(heard(), 0);
+}
+
+}  // namespace testing
+}  // namespace flutter
