+
+bool FlutterWindowsEngine::RestoreGLContext() {
+  FML_DCHECK(task_runner_->RunsTasksOnCurrentThread());
+
+  // Only an engine that renders with Impeller stands again in a context made
+  // anew (FlutterEngineNotifyGLContextLost).
+  if (!running() || !egl_manager_ || !enable_impeller_) {
+    return false;
+  }
+
+  // [anicel 0005] THE ORDER IS THE LAW, each step for the one after it.
+  //
+  // 0. 🚨THE RASTER THREAD IS ASKED FIRST WHETHER IT ANSWERS AT ALL. Every
+  //    step after waits on it from this thread, and a raster thread stuck in
+  //    the driver (board a-real-gpu-reset-went-unheard-on-the-main-pc,
+  //    2026-11-22: the window stood on its last picture) would hold the
+  //    platform thread for good -- and with it the question that saves the
+  //    work. One that does not answer is left as it is: the app asks, as it
+  //    did before the engine could restore.
+  if (!RasterThreadAnswers()) {
+    FML_LOG(ERROR) << "The raster thread does not answer: not restored.";
+    return false;
+  }
+
+  // 1. The compositor hears first, on the raster thread: the backing stores
+  //    the engine collects as it lets go are of the lost context, and are
+  //    not to be deleted through OpenGL.
+  PostRasterThreadTask(
+      [compositor = compositor_.get()] { compositor->GLContextLost(); });
+
+  // 2. The engine lets go. When this returns it calls none of the OpenGL
+  //    callbacks, and none of its threads has a context current.
+  if (embedder_api_.NotifyGLContextLost(engine_) != kSuccess) {
+    return false;
+  }
+
+  // 3. What this embedder itself had sent to the raster thread before the
+  //    loss -- a swap interval to set, a surface to destroy -- is waited
+  //    out: such a task makes a context current while it runs, and a display
+  //    one of whose contexts is current is not terminated in full.
+  if (!RasterThreadAnswers()) {
+    FML_LOG(ERROR) << "The raster thread does not answer: not restored.";
+    return false;
+  }
+
+  // 4. What this embedder holds of the lost display is forgotten, with no
+  //    call to EGL or OpenGL: it all goes with the display.
+  std::vector<FlutterWindowsView*> views_that_had_a_surface;
+  {
+    std::shared_lock read_lock(views_mutex_);
+    for (auto& [view_id, view] : views_) {
+      if (view->GLContextLost()) {
+        views_that_had_a_surface.push_back(view);
+      }
+    }
+  }
+  texture_registrar_->GLContextLost();
+
+  // 5. The display and its contexts are made anew.
+  if (!egl_manager_->MakeAnew()) {
+    FML_LOG(ERROR) << "Could not make the EGL display anew.";
+    return false;
+  }
+
+  // 6. Each view that had a surface gets one of the display made anew.
+  for (FlutterWindowsView* view : views_that_had_a_surface) {
+    view->CreateRenderSurface();
+  }
+
+  // 7. The engine stands again in the context made anew, and draws a frame.
+  return embedder_api_.NotifyGLContextRestored(engine_) == kSuccess;
+}
+
+bool FlutterWindowsEngine::RasterThreadAnswers() const {
+  // Shared: a raster thread that answers late answers to no one.
+  auto answered = std::make_shared<fml::AutoResetWaitableEvent>();
+  return PostRasterThreadTask([answered] { answered->Signal(); }) &&
+         !answered->WaitWithTimeout(kRasterThreadAnswersWithin);
+}
