@@ -36,6 +36,31 @@ void ImageExternalTextureVKImpeller::Attach(PaintContext& context) {
 
 void ImageExternalTextureVKImpeller::Detach() {}
 
+// ANICEL — not Flutter's. Every paint of this frame is with the GPU: the
+// entry is told so, and told again once the GPU has done all of it — an
+// empty submit after the frame's own, whose fence covers what the queue
+// took before it (board the-galaxy-tab-canvas-went-slow-on-build-1095, 위험 1:
+// a producer that writes its buffer again while it is read tears the frame
+// that reads it). A frame that did not draw this texture tells nothing, and
+// need not: the last frame that drew it told its own reads.
+void ImageExternalTextureVKImpeller::OnFrameSubmitted() {
+  if (read_signal_ == nullptr || painted_ == submitted_) {
+    return;
+  }
+  submitted_ = painted_;
+  const ReadSignal signal = read_signal_;
+  const int64_t id = Id();
+  const uint64_t through = submitted_;
+  signal(id, kReadSubmitted, through);
+  auto buffer = impeller_context_->CreateCommandBuffer();
+  // Told on error too: a submit that failed reads nothing more, and a
+  // producer left waiting for it would stand still.
+  [[maybe_unused]] auto status = impeller_context_->GetCommandQueue()->Submit(
+      {buffer}, [signal, id, through](impeller::CommandBuffer::Status) {
+        signal(id, kReadDone, through);
+      });
+}
